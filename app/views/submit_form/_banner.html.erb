<div class="flex mt-4">
  <% account = @submitter&.account || current_account rescue nil %>
  <% if account&.company_logo&.attached? %>
    <div class="mx-auto flex items-center space-x-3">
      <%= image_tag account.company_logo, class: 'h-10 md:h-12 object-contain' %>
      <span class="text-2xl md:text-3xl font-bold"><%= account.name %></span>
    </div>
  <% else %>
    <%= render 'submit_form/docuseal_logo' %>
  <% end %>
</div>
