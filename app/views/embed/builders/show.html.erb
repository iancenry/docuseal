<template-builder
  class="grid"
  data-template="<%= @template_data %>"
  data-with-sign-yourself-button="false"
  data-with-send-button="false"
  data-with-fields-detection="true"
  data-with-conditions="true"
  data-with-formula="true"
  data-with-phone="true"
  data-with-payment="true"
  data-locale="<%= @embed_account.locale || 'en' %>"
></template-builder>

<script>
  // Notify parent when template is saved
  document.addEventListener('template:save', function(e) {
    if (window.DocuSealEmbed) {
      window.DocuSealEmbed.postMessage('builder:save', {
        template_id: <%= @template.id %>,
        template_name: '<%= j(@template.name) %>'
      });
    }
  });
</script>
