<% content_for(:embed_pack) { 'form' } %>
<div class="text-center py-20">
  <h2 class="text-2xl font-bold mb-4"><%= t('completed') %></h2>
  <p class="text-neutral-500"><%= t('document_has_been_signed_already') %></p>
</div>

<script>
  if (window.DocuSealEmbed) {
    window.DocuSealEmbed.postMessage('form:completed', {
      submission_id: <%= @submitter.submission.id %>,
      submitter_id: <%= @submitter.id %>
    });
  }
</script>
